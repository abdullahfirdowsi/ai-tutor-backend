# API Configuration
DEBUG=true
HOST=0.0.0.0
PORT=8000

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Firebase Configuration
FIREBASE_CREDENTIALS_PATH=path/to/your/firebase-credentials.json
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id

# Database Configuration (uncomment the one you want to use)
# For PostgreSQL
# DATABASE_URL=postgresql://username:password@localhost:5432/ai_tutor
# For SQLite (for development)
DATABASE_URL=sqlite:///./ai_tutor.db

# AI Model Configuration
OPENAI_API_KEY=your_openai_api_key
DEFAULT_MODEL=gpt-3.5-turbo

# Security
JWT_SECRET_KEY=change_this_to_a_long_random_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# Logging
LOG_LEVEL=INFO
